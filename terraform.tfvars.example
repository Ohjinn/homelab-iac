proxmox_api_url          = "https://<PROXMOX_IP>:8006/api2/json"
proxmox_api_token_id     = "<USER>@pve!<TOKEN_NAME>"
proxmox_api_token_secret = "<TOKEN_SECRET>"

target_node     = "pve"
runner_user     = "your-username"
runner_password = "your-password"

ssh_public_key = <<EOF
ssh-rsa AAAA... your-key-here
EOF
